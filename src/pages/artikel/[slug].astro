---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { Breadcrumb } from '@/components/breadcrumb';
import { getAllArticles, getArticleBySlug } from '@/lib/mdx';
import type { Article } from '@/lib/mdx';
import { COMPANY_INFO } from '@/lib/constants';
import { ArrowLeft, Calendar, User, Clock, Tag, MessageSquare } from 'lucide-react';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return Promise.all(
    articles.map(async (art) => {
      const fullArticle = (await getArticleBySlug(art.slug)) as Article;
      return {
        params: { slug: art.slug },
        props: { article: fullArticle },
      };
    })
  );
}

interface Props {
  article: Article;
}

const { slug } = Astro.params;
const article: Article | null = Astro.props.article || (await getArticleBySlug(slug as string));

if (!article) {
  return Astro.redirect('/404');
}

// Dynamically resolve MDX Content component
const mdxModules = import.meta.glob<{ default: any; Content: any; frontmatter: any }>('/content/artikel/*.mdx', { eager: true });
const matchingEntry = Object.values(mdxModules).find((mod: any) =>
  mod.file?.endsWith(`${slug}.mdx`)
);
const Content = matchingEntry?.Content || matchingEntry?.default;

const articleDate = article.frontmatter.date || '2026-06-24';
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `https://growthindonesia.my.id/artikel/${slug}#article`,
  headline: article.frontmatter.title,
  description: article.frontmatter.description,
  image: [article.frontmatter.image],
  datePublished: articleDate,
  dateModified: articleDate,
  author: {
    '@type': 'Person',
    name:
      article.frontmatter.author &&
      article.frontmatter.author !== 'Admin' &&
      article.frontmatter.author !== 'Tim Growth Indonesia'
        ? article.frontmatter.author
        : 'Naftalyndho Mycha Grace Mirawandi',
    jobTitle: 'Lead Facilitator & Master Trainer',
    worksFor: {
      '@type': 'Organization',
      name: COMPANY_INFO.brand_name,
    },
  },
  publisher: {
    '@type': 'Organization',
    name: COMPANY_INFO.brand_name,
    url: 'https://growthindonesia.my.id',
    logo: {
      '@type': 'ImageObject',
      url: COMPANY_INFO.logo_url,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://growthindonesia.my.id/artikel/${slug}`,
  },
};
---
<BaseLayout
  title={article.frontmatter.title}
  description={article.frontmatter.description}
  ogImage={article.frontmatter.image}
  ogType="article"
  schema={blogPostingSchema}
>
  <div class="pt-[72px] md:pt-[88px]">
    <!-- Editorial Header -->
    <section class="relative pt-20 pb-36 md:pt-28 md:pb-48 bg-navy overflow-hidden">
      <div class="max-w-4xl mx-auto px-6 relative z-10">
        <div class="mb-8">
          <Breadcrumb
            items={[
              { label: 'Beranda', href: '/' },
              { label: 'Artikel', href: '/artikel' },
              { label: article.frontmatter.title },
            ]}
            variant="dark"
            includeSchema={true}
          />
        </div>

        <a
          href="/artikel"
          class="inline-flex items-center gap-2 text-sm font-bold text-navy-muted hover:text-brand transition-colors mb-10 group"
        >
          <ArrowLeft className="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
          Kembali ke Artikel
        </a>

        {article.frontmatter.tags && article.frontmatter.tags.length > 0 && (
          <div class="flex flex-wrap gap-2.5 mb-8">
            {article.frontmatter.tags.map((tag: string) => (
              <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-navy-2 border border-navy-border text-xs font-semibold text-white">
                <Tag className="w-3 h-3 text-brand" />
                {tag}
              </span>
            ))}
          </div>
        )}

        <h1 class="font-display text-3xl md:text-5xl font-black tracking-tight text-white mb-8 leading-tight">
          {article.frontmatter.title}
        </h1>

        <div class="flex flex-wrap items-center gap-6 text-sm text-navy-muted font-medium pt-6 border-t border-navy-border">
          <div class="flex items-center gap-2">
            <Calendar className="w-4 h-4 text-brand" />
            <span>
              {new Date(article.frontmatter.date).toLocaleDateString('id-ID', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </span>
          </div>
          <div class="flex items-center gap-2">
            <Clock className="w-4 h-4 text-brand" />
            <span>{article.frontmatter.readTime}</span>
          </div>
          <div class="flex items-center gap-2">
            <User className="w-4 h-4 text-brand" />
            <span>{article.frontmatter.author}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Image Banner -->
    <section class="bg-paper relative pb-4">
      <div class="max-w-4xl mx-auto px-6 -mt-24 md:-mt-32 relative z-20">
        <div class="aspect-[21/10] w-full rounded-3xl overflow-hidden shadow-md relative bg-paper-2 border border-navy-border">
          <img
            src={article.frontmatter.image}
            alt={article.frontmatter.title}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
          />
        </div>
      </div>
    </section>

    <!-- Article Content -->
    <section class="py-16 md:py-24 bg-white text-ink">
      <div class="max-w-4xl mx-auto px-6">
        <div class="prose prose-slate prose-lg md:prose-xl max-w-none hover:prose-headings:text-brand-dark prose-headings:font-display prose-headings:font-extrabold prose-a:text-brand-dark">
          {Content ? <Content /> : <div set:html={article.content} />}
        </div>

        <!-- In-Article WhatsApp Banner -->
        <div class="mt-16 p-8 md:p-12 bg-navy text-white rounded-3xl border border-navy-border relative overflow-hidden shadow-md">
          <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
            <div>
              <h3 class="font-display font-black text-2xl md:text-3xl tracking-tight mb-3">
                Konsultasikan Kebutuhan Tim Anda!
              </h3>
              <p class="text-navy-muted max-w-lg font-medium text-sm md:text-base mb-5">
                Dapatkan rancangan proposal kustom dan penawaran draf RAB gratis dari Master Trainer &amp; fasilitator berpengalaman kami sekarang juga.
              </p>
              <div class="flex flex-wrap gap-2 text-xs font-bold">
                <a href="/layanan/madiun/outbound" class="px-3 py-1.5 rounded-full bg-navy-2 border border-navy-border hover:bg-brand-dark text-white transition-colors">
                  Outbound Madiun
                </a>
                <a href="/layanan/magetan/outbound" class="px-3 py-1.5 rounded-full bg-navy-2 border border-navy-border hover:bg-brand-dark text-white transition-colors">
                  Outbound Sarangan
                </a>
                <a href="/layanan/madiun/ldk-osis" class="px-3 py-1.5 rounded-full bg-navy-2 border border-navy-border hover:bg-brand-dark text-white transition-colors">
                  LDK OSIS &amp; Sekolah
                </a>
                <a href="/layanan/madiun/gathering" class="px-3 py-1.5 rounded-full bg-navy-2 border border-navy-border hover:bg-brand-dark text-white transition-colors">
                  Corporate Gathering
                </a>
                <a href="/pricing.md" class="px-3 py-1.5 rounded-full bg-navy-2 border border-navy-border hover:bg-brand-dark text-white transition-colors">
                  Katalog Harga
                </a>
              </div>
            </div>
            <div class="shrink-0">
              <a
                href={`https://wa.me/${COMPANY_INFO.whatsapp_number}?text=Halo%20Growth%20Indonesia%2C%20saya%20tertarik%20dengan%20layanan%20outbound%20corporate%20training%20setelah%20membaca%20artikel%20Anda.`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-brand-dark hover:bg-brand text-white font-bold px-6 py-4 rounded-xl transition-colors duration-200 text-sm md:text-base whitespace-nowrap"
              >
                <MessageSquare className="w-5 h-5 fill-current" />
                Hubungi via WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    h1 {
      overflow-wrap: break-word;
      min-width: 0;
      text-wrap: balance;
    }
  </style>
</BaseLayout>
