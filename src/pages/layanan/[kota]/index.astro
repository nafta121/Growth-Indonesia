---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { Breadcrumb } from '@/components/breadcrumb';
import TrustSection from '@/components/trust-section';
import CityCta from '@/components/city-cta';
import { CITIES } from '@/lib/cities';
import { getCityImage } from '@/lib/city-images';
import { KATEGORI } from '@/lib/categories';
import { COMPANY_INFO } from '@/lib/constants';
import { getContentVariations } from '@/lib/content-variations';
import { getLocalBusinessSchema } from '@/lib/schema';
import { formatSlug } from '@/lib/format';
import { MapPin, ArrowRight, CheckCircle2 } from 'lucide-react';

export async function getStaticPaths() {
  return Object.keys(CITIES).map((kota) => ({
    params: { kota },
    props: { cityData: CITIES[kota] },
  }));
}

const { kota } = Astro.params;
const decodedKota = decodeURIComponent(kota as string).toLowerCase();
const cityData = Astro.props.cityData || CITIES[decodedKota];

if (!cityData) {
  return Astro.redirect('/404');
}

const kotaName = formatSlug(decodedKota);
const title = `Outbound, Team Building & EO di ${kotaName}`;
const description = `Provider outbound, team building & event organizer (EO) profesional di ${kotaName}. Melayani corporate gathering, training SDM & LDK OSIS.`;
const cityImage = getCityImage(decodedKota);
const canonicalUrl = `https://growthindonesia.my.id/layanan/${decodedKota}`;

const schemaLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `https://growthindonesia.my.id/layanan/${decodedKota}#webpage`,
    name: `Layanan Outbound & Event Organizer di ${kotaName}`,
    description: cityData.description,
    url: canonicalUrl,
    about: {
      '@type': 'Place',
      name: kotaName,
    },
  },
  {
    '@context': 'https://schema.org',
    ...getLocalBusinessSchema(kotaName),
    image: cityImage,
    description: `Provider Outbound Training, Team Building, dan Event Organizer (EO) profesional di ${kotaName}. ${cityData.uniqueSellingPoint}`,
    knowsAbout: cityData.popularVenues,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `Katalog Layanan Outbound & Event Organizer ${kotaName}`,
      itemListElement: KATEGORI.map((kategori, index) => ({
        '@type': 'OfferCatalog',
        position: index + 1,
        name: `${formatSlug(kategori)} ${kotaName}`,
        url: `https://growthindonesia.my.id/layanan/${decodedKota}/${kategori}`,
      })),
    },
  },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={cityImage}
  schema={schemaLd}
>
  <div class="flex-1 w-full flex flex-col pt-[72px] md:pt-[88px]">
    <article itemscope itemtype="https://schema.org/ProfessionalService">
      <meta itemprop="name" content={`Layanan Outbound & Event Organizer di ${kotaName}`} />
      <meta itemprop="description" content={`Provider outbound & event organizer (EO) profesional di ${kotaName}. ${cityData.description}`} />
      <meta itemprop="provider" content={COMPANY_INFO.brand_name} />
      <meta itemprop="areaServed" content={kotaName} />
      <meta itemprop="award" content="Fasilitator & Praktisi Experiential Learning Berpengalaman" />
      <meta itemprop="serviceType" content="Corporate Outbound, Team Building & Event Organizer" />

      <!-- City Hub Hero -->
      <section class="relative pt-20 pb-20 md:pt-32 md:pb-28 bg-navy overflow-hidden">
        <div class="max-w-5xl mx-auto px-4 md:px-12 relative z-10 text-center flex flex-col items-center">
          <div class="mb-6">
            <Breadcrumb
              items={[
                { label: 'Beranda', href: '/' },
                { label: 'Layanan', href: '/layanan' },
                { label: kotaName },
              ]}
              variant="dark"
              includeSchema={true}
            />
          </div>

          <h1 class="font-display text-4xl sm:text-5xl md:text-7xl font-black tracking-tight text-white mb-6 leading-tight">
            Outbound &amp; Event Organizer {kotaName}
          </h1>
          <p class="text-lg md:text-2xl text-navy-muted font-medium leading-relaxed max-w-3xl mx-auto">
            Program outbound, team building, dan event organizer profesional di wilayah {kotaName}.
          </p>
        </div>
      </section>

      <!-- 5 Categories Grid -->
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 md:px-12">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-black tracking-tight text-ink mb-4">
              Pilih Kategori Program
            </h2>
            <p class="text-lg text-muted max-w-3xl mx-auto font-medium">
              {cityData.description} Jelajahi 5 solusi pelatihan dan event organizer profesional yang tersedia di area {kotaName}.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {KATEGORI.map((kategori) => {
              const kategoriName = formatSlug(kategori);
              const variation = getContentVariations(kategori, kotaName);
              return (
                <a
                  href={`/layanan/${decodedKota}/${kategori}`}
                  class="group flex flex-col bg-paper rounded-3xl overflow-hidden border border-rule hover:border-brand/40 hover:shadow-lg hover:-translate-y-1 transition-[transform,border-color,box-shadow] duration-300"
                >
                  <div class="p-8 pb-6 flex-grow">
                    <div class="w-14 h-14 rounded-2xl bg-white shadow-sm flex items-center justify-center text-brand-dark mb-6 border border-rule group-hover:bg-brand-dark group-hover:text-white transition-colors">
                      <CheckCircle2 className="w-7 h-7" />
                    </div>
                    <h3 class="font-display font-bold text-2xl text-ink mb-3 group-hover:text-brand-dark transition-colors">
                      {kategoriName} {kotaName}
                    </h3>
                    <p class="text-ink-2 font-medium leading-relaxed mb-4">
                      {variation.bodyIntro}
                    </p>
                    <ul class="space-y-1.5 text-sm text-muted font-medium">
                      {variation.deliverables.slice(0, 2).map((item) => (
                        <li class="flex items-start gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-brand-dark mt-2 shrink-0"></span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="px-8 py-5 border-t border-rule bg-white group-hover:bg-brand-tint/40 transition-colors flex items-center justify-between">
                    <span class="font-bold text-ink group-hover:text-brand-dark text-sm">Lihat Detail Program {kategoriName}</span>
                    <ArrowRight className="w-5 h-5 text-muted group-hover:text-brand-dark group-hover:translate-x-1 transition-transform" />
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <!-- Local Information Context & Venues -->
      <section class="py-20 bg-paper border-t border-rule">
        <div class="max-w-5xl mx-auto px-4 md:px-12">
          <div class="text-center mb-12">
            <h2 class="font-display text-3xl md:text-4xl font-black text-ink mb-6">
              Keunggulan Lokasi &amp; Rekomendasi Venue di {kotaName}
            </h2>
            <p class="text-lg text-muted leading-relaxed font-medium max-w-3xl mx-auto">
              {cityData.uniqueSellingPoint} Kami mengombinasikan akses ke berbagai lokasi strategis di {kotaName} dengan metode experiential learning yang teruji.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {cityData.popularVenues.map((venue, idx) => (
              <div class="bg-white p-6 rounded-2xl border border-rule shadow-sm flex items-start gap-3">
                <MapPin className="w-5 h-5 text-brand-dark shrink-0 mt-0.5" />
                <div>
                  <h3 class="font-bold text-ink text-base leading-snug">
                    {venue}
                  </h3>
                  <p class="text-xs font-semibold text-muted mt-1 num">
                    Rekomendasi venue #{idx + 1}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </article>

    <TrustSection kategoriName="Program" kotaName={kotaName} />
    <CityCta kategoriName="Outbound & Training" kotaName={kotaName} />
  </div>
</BaseLayout>
