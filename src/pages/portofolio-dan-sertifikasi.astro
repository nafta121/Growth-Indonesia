---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import CredibilityPortfolio from '@/components/credibility-portfolio';
import Breadcrumb from '@/components/breadcrumb';
import { getLocalBusinessSchema } from '@/lib/schema';
import { COMPANY_INFO } from '@/lib/constants';

const schemaLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': 'https://growthindonesia.my.id/portofolio-dan-sertifikasi#webpage',
      name: `Portofolio Klien & Profil Fasilitator Profesional | ${COMPANY_INFO.brand_name}`,
      url: 'https://growthindonesia.my.id/portofolio-dan-sertifikasi',
      mainEntity: {
        '@id': 'https://growthindonesia.my.id/#organization',
      },
    },
    getLocalBusinessSchema(),
  ],
};
---
<BaseLayout
  title="Portofolio Klien & Profil Fasilitator | Growth Indonesia"
  description="Profil fasilitator outbound berpengalaman, rekam jejak studi kasus, dan daftar klien BUMN, instansi, serta sekolah yang menggunakan jasa Growth Indonesia."
  canonical="https://growthindonesia.my.id/portofolio-dan-sertifikasi"
  schema={schemaLd}
>
  <div class="pt-[72px] md:pt-[88px] bg-paper min-h-screen text-ink">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 mb-8">
      <Breadcrumb
        items={[
          { label: 'Beranda', href: '/' },
          { label: 'Portofolio & Profil Praktisi' },
        ]}
        variant="light"
      />
    </div>
    <CredibilityPortfolio headingLevel="h1" />

    <!-- Legal, Procurement & Privacy Disclosures (E-E-A-T Trust Section) -->
    <section class="py-16 bg-white border-t border-rule">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div id="kebijakan-privasi" class="p-6 md:p-8 rounded-3xl bg-paper border border-rule scroll-mt-28">
          <h2 class="font-display text-xl font-extrabold text-ink mb-3 tracking-tight">
            Kebijakan Privasi Data Instansi
          </h2>
          <p class="text-sm text-ink-2 leading-relaxed font-medium text-pretty">
            Data konsultasi yang dikirimkan melalui formulir web, Kalkulator Budget, maupun WhatsApp resmi Growth Indonesia (nama PIC, instansi, estimasi peserta, dan jadwal kegiatan) digunakan secara eksklusif untuk penyusunan draf proposal, rundown, serta rincian RAB resmi. Kami tidak menjual atau membagikan data kontak klien kepada pihak ketiga di luar kebutuhan koordinasi venue dan asuransi peserta atas persetujuan panitia.
          </p>
        </div>
        <div id="syarat-ketentuan" class="p-6 md:p-8 rounded-3xl bg-paper border border-rule scroll-mt-28">
          <h2 class="font-display text-xl font-extrabold text-ink mb-3 tracking-tight">
            Syarat &amp; Ketentuan Pengadaan
          </h2>
          <p class="text-sm text-ink-2 leading-relaxed font-medium text-pretty">
            Setiap pelaksanaan program mengacu pada kesepakatan proposal tertulis, standar keselamatan Zero Accident Policy, garansi skenario Plan B cuaca, serta kelengkapan dokumen administrasi pengadaan (penawaran resmi, kwitansi bermeterai, dan laporan evaluasi/LPJ). Penyesuaian jumlah peserta atau jadwal dapat dikoordinasikan bersama tim operasional kami di Jl. Mujair No.3, Kota Madiun maksimal H-7 sebelum pelaksanaan.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
