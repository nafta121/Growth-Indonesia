4 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-green-600 shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Rekomendasi pengembangan SDM berbasis laporan kualitatif fasilitator bersertifikat BNSP.</span></li></ul></div></div></div></div></div><div class=\"bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm space-y-8\"><div class=\"flex items-center gap-3 border-b border-slate-100 pb-6\"><div class=\"p-3 bg-red-100 text-red-600 rounded-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-8 h-8\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div><h3 class=\"text-2xl font-bold text-slate-900 font-display\">3. Daftar Klien &amp; Mitra Strategis</h3><p class=\"text-sm text-slate-500\">Instansi BUMN, perusahaan multinasional, sekolah, dan pemerintah yang mempercayai Growth Indonesia</p></div></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\"><div class=\"bg-slate-50 border border-slate-200 rounded-2xl p-6 space-y-4\"><div class=\"flex items-center gap-2.5 border-b border-slate-200 pb-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 w-5 h-5 text-red-600\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0