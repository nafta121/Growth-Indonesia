\":\"+6285704748186\",\"priceRange\":\"Rp 150.000 - Rp 4.500.000\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Jl. Mujair No.3\",\"addressLocality\":\"Madiun\",\"addressRegion\":\"Jawa Timur\",\"postalCode\":\"63128\",\"addressCountry\":\"ID\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":-7.6298,\"longitude\":111.5239},\"openingHoursSpecification\":[{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\"],\"opens\":\"08:00\",\"closes\":\"17:00\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Saturday\",\"opens\":\"08:00\",\"closes\":\"15:00\"}],\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"4.9\",\"reviewCount\":\"250\"},\"areaServed\":[{\"@type\":\"City\",\"name\":\"Madiun\"},{\"@type\":\"City\",\"name\":\"Magetan\"},{\"@type\":\"City\",\"name\":\"Ponorogo\"},{\"@type\":\"City\",\"name\":\"Ngawi\"},{\"@type\":\"City\",\"name\":\"Pacitan\"},{\"@type\":\"City\",\"name\":\"Kediri\"},{\"@type\":\"City\",\"name\":\"Surabaya\"},{\"@type\":\"City\",\"name\":\"Ngawi\"}],\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Layanan GROWTH INDONESIA\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Outbound\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Training\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Gathering\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"LDK\"}}]},\"sameAs\":[\"https://www.instagram.com/growthindonesia/\",\"https://www.facebook.com/growthindonesia/\"]},{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Siapa provider Gathering terbaik dan tersertifikasi di Ngawi?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GROWTH INDONESIA adalah provider Gathering di Ngawi dengan fasilitator tersertifikasi BNSP yang profesional dan sarat pengalaman meng-handle berbagai jenis project instansi maupun korporasi berskala regional hingga nasional.\"}},{\"@type\":\"Question\",\"name\":\"Berapa estimasi harga paket Gathering di Ngawi?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Harga paket Gathering di Ngawi sangat fleksibel menyesuaikan dengan kebutuhan tim, durasi kegiatan, dan kompleksitas acara Anda. Anda bisa mensimulasikannya via Kalkulator Budget GROWTH INDONESIA.\"}},{\"@type\":\"Question\",\"name\":\"Apakah kegiatan Gathering di Ngawi aman?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ya, GROWTH INDONESIA menerapkan 'Zero Accident Policy' untuk seluruh aktivitas outdoor learning maupun in-class. Area observasi yang berada di wilayah Ngawi selalu dipastikan kelayakannya secara periodik.\"}}],\"@id\":\"https://growthindonesia.my.id/#faq\",\"name\":\"FAQ Seputar Layanan Growth Indonesia\"}]}11:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1b\"}}],\"$L1c\"]\n1d:I[1356,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"288\",\"static/chunks/288-4ffc23b09b8841f6.js\",\"356\",\"static/chunks/356-29427fd00f1c4ea7.js\",\"12\",\"static/chunks/app/layanan/%5Bkota%5D/%5Bkategori%5D/page-d56306f79d805665.js\"],\"Image\"]\n1e:I[7206,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"288\",\"static/chunks/288-4ffc23b09b8841f6.js\",\"356\",\"static/chunks/356-29427fd00f1c4ea7.js\",\"12\",\"static/chunks/app/layanan/%5Bkota%5D/%5Bkategori%5D/page-d56306f79d805665.js\"],\"default\"]\n1f:I[1183,[\"619\",\"static/chunks/619-ba102abea3e3d0e4.js\",\"288\",\"static/chunks/288-4ffc23b09b8841f6.js\",\"356\",\"static/chunks/356-29427fd00f1c4ea7.js\",\"12\",\"static/chunks/app/layanan/%5Bkota%5D/%5Bkategori%5D/page-d56306f79d805665.js\"],\"Breadcrumb\"]\n1c:[\"$\",\"main\",null,{\"className\":\"flex-1 w-full flex flex-col pt-[72px] md:pt-[88px]\",\"children\":[[\"$\",\"article\",null,{\"itemScope\":true,\"itemType\":\"https://schema.org/Service\",\"children\"