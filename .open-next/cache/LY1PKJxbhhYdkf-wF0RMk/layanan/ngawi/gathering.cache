 fun games seru, dan family gathering di berbagai destinasi favorit seperti Benteng Pendem, Srambang Park, Watu Jonggol hingga area bebas pilihan Anda.\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"34:[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-video w-7 h-7\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"ftymec\\\",{\\\"d\\\":\\\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\\\"}],[\\\"$\\\",\\\"rect\\\",\\\"158x01\\\",{\\\"x\\\":\\\"2\\\",\\\"y\\\":\\\"6\\\",\\\"width\\\":\\\"14\\\",\\\"height\\\":\\\"12\\\",\\\"rx\\\":\\\"2\\\"}],\\\"$undefined\\\"]}]\\n35:[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-xl md:text-2xl font-black font-display text-[#0A1628] mb-4\\\",\\\"children\\\":\\\"Modern Documentation\\\"}]\\n36:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-slate-600 leading-relaxed font-medium\\\",\\\"children\\\":\\\"Paket yang ditawarkan mencakup tim media profesional dengan peralatan lengkap mulai dari Drone, Mirrorless, hingga produksi video cinematic.\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"37:[\\\"$\\\",\\\"$L1e\\\",null,{\\\"delay\\\":0.2,\\\"className\\\":\\\"max-w-5xl mx-auto relative\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-center mb-10\\\",\\\"children\\\":[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-display text-2xl md:text-4xl font-black tracking-tight text-[#0A1628]\\\",\\\"children\\\":\\\"Perbandingan Value \\u0026 Kualitas\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"bg-white border border-slate-200 rounded-[2.5rem] shadow-xl shadow-slate-200/50 overflow-