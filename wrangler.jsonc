{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-indonesia",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "giwebsite": {
      "name": "giwebsite"
    }
  }
}
