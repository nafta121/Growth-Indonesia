{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-indonesia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "growth-indonesia"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growth-cms",
      "database_id": "47031daa-8730-4f55-b403-cbcd9284eca6"
    }
  ]
}
